TARGET_ENVIRONMENT=local
WALP_APP_VERSION=0.0.1

WALPAPP_DB_READ_ONLY_HOST=
WALPAPP_DB_READ_WRITE_HOST=localhost
WALPAPP_DB_READ_ONLY_PORT=
WALPAPP_DB_READ_WRITE_PORT=5432
WALPAPP_DB_USER=walpdbadmin
WALPAPP_DB_PASSWORD=
WALPAPP_DB_PASSWORD_SSM_NAME=WalpApp-RDS-$TARGET_ENVIRONMENT-MasterPassword

WALPAPP_PROD_PROFILE=waterlily-prod
WALPAPP_DEV_PROFILE=waterlily-dev

WALPAPP_PDF_USER=pdf@joinwaterlily.com
# get from dev parameter store WalpApp-PDF-User-dev-Password
WALPAPP_PDF_PASSWORD=

WALPAPP_PDF_PASSWORD_SSM_NAME=WalpApp-PDF-User-dev-Password

WALP_ALGO_AUTH_TOKEN=
WALPAPP_ALGO_AUTH_TOKEN_SSM_NAME=WalpApp-DataBricks-prod-AuthToken

WALPAPP_PAUBOX_USER=joinwaterlily
# get from dev parameter store WalpApp-Paubox-API-Key
WALPAPP_PAUBOX_API_KEY=
WALPAPP_PAUBOX_API_KEY_SSM_NAME=WalpApp-Paubox-API-Key

WALPAPP_CREATE_MAGIC_LINK=true

# get from dev parameter store WalpApp-Scheduled-Events-API-Key
WALPAPP_SCHEDULED_EVENTS_API_KEY=
WALPAPP_SCHEDULED_EVENTS_API_KEY_SSM_NAME=WalpApp-Scheduled-Events-API-Key

WALPAPP_INTERCOM_IDENTITY_VERIFICATION_KEY=
WALPAPP_INTERCOM_IDENTITY_VERIFICATION_KEY_SSM_NAME=WalpApp-Intercom-Identity-Verification-Key

WALPAPP_OPENAI_API_KEY=
WALPAPP_OPENAI_API_KEY_SSM_NAME=WalpApp-OpenAI-API-Key