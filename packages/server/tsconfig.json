{
  "compilerOptions": {
    "baseUrl": ".",
    "lib": [
      "ESNext"
    ],
    "moduleResolution": "Node",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "removeComments": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "ES2020",
    "outDir": "build",
    "allowSyntheticDefaultImports": true,
    "alwaysStrict": true,
    "typeRoots": [
      "../shared/src/types",
      "./src/types",
      "../../node_modules/@types"
    ],
    "paths": {
      "@shared": ["../shared/src"],
      "@client": ["../client/src"],
      "@server": ["../server/src"],
      "@shared/*": ["../shared/src/*"],
      "@client/*": ["../client/src/*"],
      "@server/*": ["../server/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/services/postRoleFitFromSupportProviderSurveyForPublic.ts"
  ],
  "exclude": [
    "../../node_modules/**/*",
    ".serverless/**/*",
    ".webpack/**/*",
    "_warmup/**/*",
    ".vscode/**/*"
  ],
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ]
  }
}