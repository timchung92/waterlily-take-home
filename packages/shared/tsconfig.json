{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "typeRoots": [
        "./src/types",
        "../../node_modules/@types"
    ],
    "paths": {
      "@shared": ["../shared/src"],
      "@client": ["../client/src"],
      "@server": ["../server/src"],
      "@shared/*": ["../shared/src/*"],
      "@client/*": ["../client/src/*"],
      "@server/*": ["../server/src/*"]
    },
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
